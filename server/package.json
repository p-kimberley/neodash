{
  "name": "neodash-server",
  "version": "0.1.0",
  "private": true,
  "description": "NeoDash backend: OIDC login, role-based query execution against Neo4j, dashboard storage and audit logging.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --mode integration test/integration",
    "test:e2e": "vitest run --mode e2e test/e2e"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.2",
    "@fastify/static": "8.3.0",
    "fastify": "5.12.5",
    "jose": "5.10.0",
    "neo4j-driver": "5.28.3",
    "openid-client": "6.8.8",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "pino-pretty": "13.1.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
