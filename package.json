{
  "name": "neodash",
  "version": "3.6.0",
  "description": "NeoDash - Neo4j Dashboard Builder",
  "neo4jDesktop": {
    "apiVersion": "^1.2.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/neo4j-contrib/neodash/"
  },
  "license": "Apache-2.0",
  "icons": [
    {
      "src": "favicon.ico",
      "type": "ico"
    },
    {
      "src": "favicon.png",
      "type": "png"
    }
  ],
  "scripts": {
    "dev": "yarn docs && yarn webpack-dev-server --mode development",
    "prod": "yarn webpack-dev-server --mode production",
    "debug": "yarn --node-options='--inspect' webpack-dev-server --mode development",
    "build": "yarn webpack --mode production --env production && cp -r public/* dist/ && node scripts/build-docs.mjs dist/docs",
    "build-minimal": "yarn webpack --mode production --env production && cp -r public/* dist/ && node scripts/build-docs.mjs dist/docs",
    "docs": "node scripts/build-docs.mjs docs/build",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "lint": "eslint .",
    "lint-staged": "lint-staged --config .lintstagedrc.json",
    "test": "sh dev/e2e/run.sh",
    "test:server": "yarn --cwd server test",
    "hooks": "husky"
  },
  "keywords": [],
  "author": "Neo4j Contrib",
  "dependencies": {
    "@babel/runtime": "^7.29.0",
    "@codemirror/lang-markdown": "^6.1.1",
    "@dnd-kit/core": "^6.0.8",
    "@dnd-kit/sortable": "^7.0.2",
    "@dnd-kit/utilities": "^3.2.1",
    "@fontsource/fira-code": "5.3.0",
    "@fontsource/nunito-sans": "5.3.0",
    "@fontsource/roboto": "5.3.0",
    "@neo4j-cypher/react-codemirror": "^1.0.3",
    "@neo4j-ndl/base": "4.23.8",
    "@neo4j-ndl/react": "4.25.10",
    "@redux-devtools/extension": "^3.3.0",
    "@tanstack/react-table": "8.21.3",
    "chroma-js": "^2.4.2",
    "classnames": "^2.3.1",
    "d3-format": "^3.1.2",
    "d3-hierarchy": "^3.1.2",
    "d3-interpolate": "^3.0.1",
    "d3-scale-chromatic": "^3.0.0",
    "d3-time-format": "^4.1.0",
    "dom-to-image": "^2.6.0",
    "dompurify": "^3.1.0",
    "echarts": "^6.1.0",
    "lodash": "^4.18.1",
    "maplibre-gl": "^6.15.0",
    "neo4j-driver-core": "5.28.3",
    "postcss": "^8.4.21",
    "postcss-loader": "^8.2.1",
    "postcss-preset-env": "^10.6.1",
    "react": "^19.3.1",
    "react-cool-dimensions": "^2.0.7",
    "react-dom": "^19.3.1",
    "react-force-graph-2d": "^1.29.2",
    "react-force-graph-3d": "^1.29.2",
    "react-grid-layout": "^1.3.4",
    "react-markdown": "^10.1.0",
    "react-redux": "^9.3.0",
    "react-use-error-boundary": "^3.0.0",
    "redux": "^5.0.1",
    "redux-persist": "^6.0.0",
    "redux-thunk": "^3.1.0",
    "remark-gfm": "^4.0.0",
    "reselect": "^4.1.8",
    "supercluster": "^9.1.0",
    "tailwindcss": "^3.3.2",
    "three": "^0.186.1",
    "three-spritetext": "^1.10.0",
    "urijs": "^1.19.11",
    "yaml": "^2.2.1"
  },
  "devDependencies": {
    "@asciidoctor/core": "4.1.1",
    "@babel/core": "^7.16.12",
    "@babel/plugin-transform-runtime": "^7.16.10",
    "@babel/preset-env": "^7.16.11",
    "@babel/preset-react": "^7.16.7",
    "@babel/preset-typescript": "^7.16.7",
    "@eslint/js": "^9.39.5",
    "@pmmmwh/react-refresh-webpack-plugin": "^0.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "babel-loader": "^10.1.1",
    "css-loader": "^7.1.5",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "react-refresh": "^0.19.0",
    "source-map-loader": "^5.0.0",
    "style-loader": "^4.0.0",
    "terser-webpack-plugin": "^5.3.10",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.0",
    "webpack": "^5.77.0",
    "webpack-cli": "^6.0.1",
    "webpack-dev-server": "^5.2.7"
  },
  "resolutions": {
    "@neo4j-cypher/react-codemirror": "1.0.4",
    "lodash": "4.18.1",
    "three-forcegraph": "^1.43.6"
  }
}
