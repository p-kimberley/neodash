@tailwind base;
@tailwind components;
@tailwind utilities;

/* Create CSS class based components */
/* https://tailwindcss.com/docs/reusing-styles#extracting-classes-with-apply */
@layer components {
  /* Page structure */
  .page-spacing {
    @apply n-p-2 sm:n-p-3 md:n-p-4;
  }

  .page-spacing-overflow {
    @apply n-pb-2 sm:n-pb-3 md:n-pb-4;
  }

  /* Tabs */
  /* The page menu button keeps its space when hidden, so tabs don't shift on hover. */
  .visible-on-tab-hover {
    visibility: hidden;
  }

  .nd-page-tab:hover .visible-on-tab-hover,
  .nd-page-tab:focus-within .visible-on-tab-hover,
  .nd-page-tab .visible-on-tab-hover.open-menu {
    visibility: visible;
  }

  /* Override Mui default z-index */
  .MuiAppBar-root.n-z-20 {
    z-index: 20 !important;
  }

  /* Utility functions for buttons */
  .btn-icon-sm-r {
    @apply n-ml-token-2 n-w-4 n-h-4;
  }
  .btn-icon-sm-l {
    @apply n-mr-token-2 n-w-4 n-h-4;
  }

  .btn-icon-base-r-m {
    @apply n-ml-token-4 n-w-5 n-h-5;
  }

  .btn-icon-base-r {
    @apply n-ml-token-4 n-w-6 n-h-6;
  }

  .btn-icon-base-l {
    @apply n-mr-token-4 n-w-6 n-h-6;
  }

  .btn-icon-lg-r {
    @apply n-ml-token-8 n-w-8 n-h-8;
  }

  .btn-icon-lg-l {
    @apply n-mr-token-8 n-w-8 n-h-8;
  }

  /* Utility functions for icons */
  .icon-base {
    @apply n-w-6 n-h-6;
  }

  .icon-inline {
    @apply n-inline n-mb-1;
  }

  .icon-inline.text-r {
    @apply n-mr-token-4;
  }

  .icon-inline.text-l {
    @apply n-ml-token-4;
  }

  /* DataGrid overrides */
  .MuiDataGrid-footerContainer > div {
    @apply n-mt-0;
  }

  /* Make bullet list points in Markdown card view */
  .card-view ul {
    @apply n-list-disc n-ml-token-24;
  }

  .ndl-dialog.dialog-xl {
    max-width: 75%;
  }

  .ndl-dialog.dialog-xxl {
    max-width: 90%;
  }

  .n-bg-dark-neutral-text-weak {
    background-color: rgb(196 200 205 / var(--tw-bg-opacity)) !important;
  }

  /* Markdown table styles */
}
